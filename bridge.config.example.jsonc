// Copy to bridge.config.jsonc and edit. Every field is optional —
// defaults describe a working setup (see src/config.ts).
{
  // tmux session name
  "session": "bridge",

  // daemon HTTP port (binds 127.0.0.1 only)
  "daemonPort": 4770,

  // Working directory agents launch in (default: the dir `bridge up` runs in)
  // "repo": ".",

  // Ordered roster: Phase 0 supports one Claude Code and one Codex instance.
  "agents": [
    { "id": "claude", "kind": "claude", "enabled": true, "command": "claude" },
    { "id": "codex", "kind": "codex", "enabled": true, "command": "codex" }
  ]
}
